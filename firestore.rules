rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleIs(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return roleIs('super_admin');
    }

    function isCompanyAdmin(companyId) {
      return roleIs('company_admin') &&
        request.auth.token.companyId is string &&
        request.auth.token.companyId == companyId;
    }

    function isCompanyMember(companyId) {
      return signedIn() &&
        request.auth.token.companyId is string &&
        request.auth.token.companyId == companyId &&
        (request.auth.token.role == 'company_admin' ||
          request.auth.token.role == 'company_employee');
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // All mutations pass through callable functions using the Admin SDK.
    match /users/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin() ||
        (resource.data.companyId is string && isCompanyMember(resource.data.companyId));
      allow write: if false;
    }

    match /companyApplications/{applicationId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && (
          resource.data.applicantUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ));
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isCompanyMember(companyId);
      allow write: if false;
    }

    match /driverInvites/{inviteId} {
      allow get: if isSuperAdmin() ||
        (resource.data.keys().hasAny(['companyId']) &&
          isCompanyMember(resource.data.companyId));
      // List queries must constrain companyId == auth.token.companyId
      allow list: if isSuperAdmin() ||
        (signedIn() &&
          request.auth.token.companyId is string &&
          resource.data.companyId == request.auth.token.companyId &&
          (request.auth.token.role == 'company_admin' ||
            request.auth.token.role == 'company_employee'));
      allow write: if false;
    }

    match /clientInvites/{inviteId} {
      allow get: if isSuperAdmin() ||
        (resource.data.keys().hasAny(['companyId']) &&
          isCompanyMember(resource.data.companyId));
      allow list: if isSuperAdmin() ||
        (signedIn() &&
          request.auth.token.companyId is string &&
          resource.data.companyId == request.auth.token.companyId &&
          (request.auth.token.role == 'company_admin' ||
            request.auth.token.role == 'company_employee'));
      allow write: if false;
    }

    match /memberships/{membershipId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if signedIn() &&
        resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /driverApplications/{applicationId} {
      allow get: if isSuperAdmin() ||
        (signedIn() && (
          resource.data.applicantUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )) ||
        (resource.data.keys().hasAny(['companyId']) &&
          isCompanyMember(resource.data.companyId));
      allow list: if isSuperAdmin() ||
        (signedIn() &&
          resource.data.applicantUid == request.auth.uid) ||
        (signedIn() &&
          resource.data.userId == request.auth.uid) ||
        (signedIn() &&
          request.auth.token.companyId is string &&
          resource.data.companyId == request.auth.token.companyId &&
          (request.auth.token.role == 'company_admin' ||
            request.auth.token.role == 'company_employee'));
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow get: if isSuperAdmin() || isOwner(driverId) ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        (resource.data.keys().hasAny(['companyId']) &&
          isCompanyMember(resource.data.companyId));
      // List queries must constrain companyId == auth.token.companyId
      allow list: if isSuperAdmin() ||
        (signedIn() &&
          request.auth.token.companyId is string &&
          resource.data.companyId == request.auth.token.companyId &&
          (request.auth.token.role == 'company_admin' ||
            request.auth.token.role == 'company_employee'));
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() ||
        (resource.data.companyId is string && isCompanyMember(resource.data.companyId));
      allow write: if false;
    }

    // Hot path: one small live position doc per driver (throttled client writes).
    // get: any signed-in user who already knows driverId (order tracking).
    // list: company staff scoped by companyId (token claims, with users/ fallback).
    function callerCompanyId() {
      return request.auth.token.companyId is string
        ? request.auth.token.companyId
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function isCompanyStaffCaller() {
      return signedIn() && (
        request.auth.token.role == 'company_admin' ||
        request.auth.token.role == 'company_employee' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_employee'
      );
    }

    match /driver_locations/{driverId} {
      allow get: if signedIn();

      // Client must query where companyId == callerCompanyId().
      allow list: if isSuperAdmin() ||
        (isCompanyStaffCaller() &&
          callerCompanyId() is string &&
          resource.data.companyId == callerCompanyId());

      allow create, update: if isOwner(driverId) &&
        request.resource.data.driverId == driverId &&
        request.resource.data.companyId is string &&
        request.resource.data.companyId.size() > 0 &&
        request.resource.data.orderId is string &&
        request.resource.data.latitude is number &&
        request.resource.data.longitude is number &&
        request.resource.data.heading is number &&
        request.resource.data.speed is number;

      allow delete: if isOwner(driverId) || isSuperAdmin();
    }

    // Batched route breadcrumbs — not used by live map listeners.
    match /orders/{orderId}/route_history/{batchId} {
      allow read: if isSuperAdmin() ||
        (resource.data.companyId is string &&
          isCompanyMember(resource.data.companyId)) ||
        (signedIn() &&
          resource.data.driverId is string &&
          resource.data.driverId == request.auth.uid);

      allow create: if signedIn() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.orderId == orderId &&
        request.resource.data.companyId is string &&
        request.resource.data.points is list &&
        request.resource.data.points.size() > 0 &&
        request.resource.data.points.size() <= 200;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
